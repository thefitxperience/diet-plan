# Copy to .env.local and fill in. All VITE_* values are public (shipped to the browser);
# security relies on Supabase RLS, not on hiding these.

# Supabase project (Settings → API)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Generation API proxy (existing Cloudflare Worker)
VITE_FIT_PROXY_URL=https://fit-proxy.andyayas27.workers.dev

# FIT API basic auth (known debt: move into the Worker, see plan §11)
VITE_FIT_API_USER=fit
VITE_FIT_API_PASS=Fit@2024

# EmailJS (optional, for email delivery) — https://www.emailjs.com
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Base path for GitHub Pages (repo name). Set to / for custom domain.
VITE_BASE=/nutrifit/
