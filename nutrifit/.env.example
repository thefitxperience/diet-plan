# Copy to .env.local and fill in. All VITE_* values are public (shipped to the browser);
# security relies on Supabase RLS, not on hiding these.

# Supabase project (Settings → API)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# Email delivery — preferred: your own SMTP relay Worker (see email-worker/).
# Sends from your mailbox (e.g. Infomaniak) with the PDF attached.
VITE_EMAIL_WORKER_URL=
VITE_EMAIL_RELAY_TOKEN=

# EmailJS (fallback, link only) — https://www.emailjs.com
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Base path for GitHub Pages (repo name). Set to / for custom domain.
VITE_BASE=/nutrifit/
